{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Craft Argument Graph v1",
  "description": "Structure only. IDs and references require the CLI validator. Scientific judgment remains manual.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "research_question",
    "analysis_scope",
    "inputs",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "research_question": {
      "type": "string"
    },
    "analysis_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "locator"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "origins",
        "scope",
        "support_state",
        "provenance",
        "verification_scope",
        "unresolved_questions",
        "next_action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "kind": {
          "enum": [
            "claim",
            "assumption",
            "evidence",
            "alternative",
            "qualification"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          },
          "minItems": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "support_state": {
          "enum": [
            "directly_verified",
            "partially_verified",
            "indirectly_supported",
            "needs_validation",
            "unsupported",
            "cannot_determine"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "artifacts",
            "run_locator"
          ],
          "properties": {
            "kind": {
              "enum": [
                "manuscript_reported",
                "mathematical_check",
                "source_code",
                "numerical_reproduction",
                "simulation",
                "hardware_measurement",
                "independently_reproduced",
                "hypothesis",
                "inference",
                "unknown"
              ]
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/locator"
              }
            },
            "run_locator": {
              "type": "string"
            }
          }
        },
        "verification_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "performed",
            "unperformed"
          ],
          "properties": {
            "performed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "unperformed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "description": "Performed and unperformed check identifiers must be disjoint; enforced by the CLI."
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "next_action": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "properties": {
                  "kind": {
                    "const": "independently_reproduced"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "artifacts": {
                    "minItems": 1
                  },
                  "run_locator": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              },
              "verification_scope": {
                "properties": {
                  "performed": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "kind": {
          "enum": [
            "requires",
            "supports",
            "contradicts",
            "alternative_to",
            "qualifies",
            "derived_from"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "nodes": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "research_question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "analysis_scope": {
            "properties": {
              "included": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
